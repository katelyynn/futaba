{
  "imports": {
    "@oak/oak": "jsr:@oak/oak@^17.2.0",
    "@tajpouria/cors": "jsr:@tajpouria/cors@^1.2.1",
    "@/": "./src/"
  },
  "tasks": {
      "dev": "deno run -A npm:vite & deno run server:start",
      "build": "deno run -A npm:vite build",
      "server:start": "deno run -A --watch ./api/main.ts",
      "serve": "deno task build && deno task preview",
      "preview": "deno run -A npm:vite preview",
      "app": "deno desktop ."
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
      "types": [
          "react",
          "react-dom",
          "@types/react"
      ],
      "lib": [
          "dom",
          "dom.iterable",
          "deno.ns"
      ],
      "jsx": "react-jsx",
      "jsxImportSource": "react"
  },
  "desktop": {
    "app": {
      "name": "futaba",
      "identifier": "moe.katelyn.futaba",
      "deepLinks": ["futaba"],
      "icons": {
        "windows": "./public/favicon.ico"
      }
    },
    "output": {
      "macos": "./dist/futaba.app",
      "windows": "./dist/futaba.msi",
      "linux": "./dist/futaba.AppImage"
    },
    "backend": "cef"
  }
}
