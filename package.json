{
  "name": "futaba",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build && bash -c \"cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/\" && npx electron-builder",
    "start": "next start",
    "lint": "eslint",
    "electron": "electron .",
    "dev:electron": "concurrently \"bun run dev\" \"bun run electron \""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tabler/icons-react": "^3.40.0",
    "@tanstack/react-query": "^5.95.2",
    "concurrently": "^9.2.1",
    "culori": "^4.0.2",
    "fast-average-color": "^9.5.1",
    "luxon": "^3.7.2",
    "md5": "^2.3.0",
    "next": "16.2.1",
    "next-electron-rsc": "^0.3.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/luxon": "^3.7.1",
    "@types/md5": "^2.3.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "build": {
    "appId": "moe.katelyn.futaba",
    "files": [
      "electron",
      ".next/**/*",
      "public/**/*",
      "package.json"
    ],
    "asarUnpack": [
      ".next/**/*",
      "public/**/*"
    ]
  }
}
